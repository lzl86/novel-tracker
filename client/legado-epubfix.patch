+package io.legado.app.model.fileBook
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class EpubChapterPositionTest {
+    @Test fun insertionBeforeCurrentChapterKeepsTitle() {
+        assertEquals(2, epubChapterPosition(listOf("新增", "第232章", "第233章"), "第233章", 1))
+    }
+    @Test fun removedTitleKeepsNearestValidIndex() {
+        assertEquals(1, epubChapterPosition(listOf("第232章", "第234章"), "第233章", 2))
+    }
+    @Test fun repeatedTitlesPreferNearestPosition() {
+        assertEquals(2, epubChapterPosition(listOf("说明", "第233章", "说明"), "说明", 2))
+    }
+    @Test fun noSavedTitleDoesNotJumpToBlankChapter() {
+        assertEquals(2, epubChapterPosition(listOf("", "第233章", "第234章"), "", 2))
+    }
+}
