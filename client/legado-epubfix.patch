diff --git a/data/src/jvmAndAndroidMain/kotlin/io/legado/app/model/fileBook/RemoteEpubSnapshot.kt b/data/src/jvmAndAndroidMain/kotlin/io/legado/app/model/fileBook/RemoteEpubSnapshot.kt
