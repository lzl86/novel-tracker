+package io.legado.app.model.fileBook
+
+/** Keep the same chapter when an updated EPUB inserts/removes/reorders earlier entries. */
+internal fun epubChapterPosition(titles: List<String>, title: String, index: Int): Int {
+    if (titles.isEmpty()) return 0
+    return titles.indices.filter { title.isNotBlank() && titles[it] == title }
+        .minByOrNull { kotlin.math.abs(it.toLong() - index.toLong()) }
+        ?: index.coerceIn(0, titles.lastIndex)
+}
