@@ -0,0 +1,45 @@
+package io.legado.app.help.update
+
+import io.legado.app.help.http.OkHttpClientProviders
+import io.legado.app.help.http.newCallResponse
+import io.legado.app.help.http.text
+import io.legado.app.utils.KS_JSON
+import kotlinx.serialization.decodeFromString
+
+/** Explicit own-channel checker; no fallback to community, including on API failure. */
+class NovelTrackerReleaseChecker : UpdateChecker {
+    override suspend fun check(request: UpdateCheckRequest): UpdateCheckResult = runCatching {
+        require(request.platform == UpdatePlatform.ANDROID) { "配套更新仅支持 Android" }
+        require(request.supportedAbis.any { it == "arm64-v8a" || it == "arm64" }) { "配套更新仅支持 ARM64" }
+        val repo = NovelTrackerReleasePolicy.REPO
+        val response = OkHttpClientProviders.get().okHttpClient.newCallResponse {
+            url("https://api.github.com/repos/$repo/releases?per_page=100")
+        }
+        val releases = try {
+            check(response.isSuccessful) { "配套客户端更新检查失败(${response.code})" }
+            KS_JSON.decodeFromString<List<GithubRelease>>(response.body.text())
+        } finally { response.close() }
+        val release = releases.filter {
+            NovelTrackerReleasePolicy.version(it.tagName.orEmpty()) != null &&
+                it.assets.orEmpty().any { asset ->
+                    asset.state == "uploaded" && asset.name == NovelTrackerReleasePolicy.ASSET &&
+                        NovelTrackerReleasePolicy.isAllowedDownload(asset.apkUrl)
+                }
+        }.maxWithOrNull { a, b ->
+            AppVersions.compare(NovelTrackerReleasePolicy.version(a.tagName!!)!!,
+                NovelTrackerReleasePolicy.version(b.tagName!!)!!)
+        } ?: error("尚无可用的配套客户端更新，请稍后重试")
+        if (!NovelTrackerReleasePolicy.isNewer(release.tagName!!, request.currentVersionName)) {
+            return@runCatching UpdateCheckResult.UpToDate
+        }
+        val asset = release.assets!!.first { it.name == NovelTrackerReleasePolicy.ASSET &&
+            it.state == "uploaded" && NovelTrackerReleasePolicy.isAllowedDownload(it.apkUrl) }
+        UpdateCheckResult.NewVersion(UpdateCheckInfo(
+            versionName = NovelTrackerReleasePolicy.version(release.tagName!!)!!,
+            releaseNote = release.body,
+            downloadUrl = asset.apkUrl,
+            fileName = asset.name,
+            landingUrl = "https://github.com/$repo/releases/tag/${release.tagName}",
+        ))
+    }.getOrElse { UpdateCheckResult.Failed(it) }
+}
