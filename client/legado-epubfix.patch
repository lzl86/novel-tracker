@@ -0,0 +1,15 @@
+package io.legado.app.help.update
+
+/** Dedicated companion channel: never interpret unrelated repo releases as APK updates. */
+object NovelTrackerReleasePolicy {
+    const val REPO = "lzl86/novel-tracker"
+    const val ASSET = "legado-epubfix-arm64.apk"
+    private val tagPattern = Regex("reader-epubfix-(\\d+\\.\\d+\\.\\d+)")
+    fun version(tag: String): String? = tagPattern.matchEntire(tag)?.groupValues?.get(1)
+    fun isNewer(tag: String, current: String): Boolean = version(tag)?.let {
+        AppVersions.isNewer(it, current.removeSuffix("debug"))
+    } ?: false
+    fun isAllowedDownload(url: String): Boolean =
+        url.startsWith("https://github.com/$REPO/releases/download/reader-epubfix-") &&
+            url.endsWith("/$ASSET") && !url.contains("?") && !url.contains("#")
+}
