+++ b/data/src/jvmAndAndroidMain/kotlin/io/legado/app/model/fileBook/RemoteEpubSnapshot.kt
@@ -0,0 +1,69 @@
+package io.legado.app.model.fileBook
+
+import okhttp3.OkHttpClient
+import okhttp3.HttpUrl
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.Request
+import java.io.IOException
+
+/** One HTTP representation. Never combine a cached ZIP directory with a different file. */
+internal class RemoteEpubSnapshot private constructor(
+    private val client: OkHttpClient,
+    private val url: HttpUrl,
+    val size: Long,
+    private val etag: String?,
+    private val modified: String?,
+) {
+    val identity: String = "$url|$size|$etag|$modified"
+
+    fun readRange(offset: Long, length: Int): ByteArray {
+        if (length <= 0 || offset >= size) return ByteArray(0)
+        val end = minOf(size - 1, offset + length - 1)
+        val builder = Request.Builder().url(url)
+            .header("Range", "bytes=$offset-$end")
+            .header("Accept-Encoding", "identity")
+            .header("Cache-Control", "no-cache")
+        if (etag != null && !etag.startsWith("W/")) builder.header("If-Match", etag)
+        else if (modified != null) builder.header("If-Unmodified-Since", modified)
+        client.newCall(builder.build()).execute().use { response ->
+            if (response.code != 206) throw IOException("EPUB 已更新或不支持 Range (${response.code})，请更新目录")
+            if ((etag != null && response.header("ETag") != etag) ||
+                (modified != null && response.header("Last-Modified") != modified) ||
+                response.header("Content-Range") != "bytes $offset-$end/$size") {
+                throw IOException("EPUB 文件版本已改变，请更新目录")
+            }
+            val bytes = response.body.bytes()
+            if (bytes.size.toLong() != end - offset + 1) throw IOException("EPUB Range 数据不完整")
+            return bytes
+        }
+    }
+
+    companion object {
+        fun probe(client: OkHttpClient, address: String): RemoteEpubSnapshot {
+            var url = address.toHttpUrl()
+            repeat(2) {
+                val request = Request.Builder().url(url).header("Range", "bytes=0-0")
+                    .header("Accept-Encoding", "identity").header("Cache-Control", "no-cache").build()
+                client.newCall(request).execute().use { response ->
+                    if (response.code == 410) {
+                        val next = response.header("X-NovelTracker-Latest-URL")
+                            ?.let { response.request.url.resolve(it) }
+                        if (next == null || next.host != url.host || next.port != url.port || next.scheme != url.scheme) {
+                            throw IOException("EPUB 下载地址已失效，请刷新书库")
+                        }
+                        url = next
+                    } else {
+                        val size = response.header("Content-Range")?.substringAfterLast('/')?.toLongOrNull()
+                        if (response.code != 206 || size == null || size <= 0 ||
+                            response.header("Content-Range") != "bytes 0-0/$size" || response.body.bytes().size != 1) {
+                            throw IOException("无法读取 EPUB 文件版本 (${response.code})")
+                        }
+                        return RemoteEpubSnapshot(client, response.request.url, size,
+                            response.header("ETag"), response.header("Last-Modified"))
+                    }
+                }
+            }
+            throw IOException("EPUB 更新过于频繁，请稍后重试")
+        }
+    }
