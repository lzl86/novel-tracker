+package io.legado.app.model.fileBook
+
+import com.sun.net.httpserver.HttpServer
+import okhttp3.OkHttpClient
+import org.junit.Assert.*
+import org.junit.After
+import org.junit.Test
+import java.io.IOException
+import java.net.InetSocketAddress
+
+class RemoteEpubSnapshotTest {
+    private val server = HttpServer.create(InetSocketAddress("127.0.0.1", 0), 0).apply { start() }
+    private val url = "http://127.0.0.1:${server.address.port}"
+    private val client = OkHttpClient()
+    private var version = "\"v1\""
+    private var body = byteArrayOf(80, 75, 3, 4)
+    private var badRange = false
+
+    init {
+        server.createContext("/book") { exchange ->
+            val (start, end) = exchange.requestHeaders.getFirst("Range")
+                .removePrefix("bytes=").split('-').map { it.toInt() }
+            exchange.responseHeaders.add("ETag", version)
+            if (exchange.requestHeaders.getFirst("If-Match")?.let { it != version } == true) {
+                exchange.sendResponseHeaders(412, -1)
+            } else {
+                val data = body.copyOfRange(start, end + 1)
+                exchange.responseHeaders.add("Content-Range", if (badRange) "bytes 1-1/${body.size}" else "bytes $start-$end/${body.size}")
+                exchange.sendResponseHeaders(206, data.size.toLong())
+                exchange.responseBody.write(data)
+            }
+            exchange.close()
+        }
+        server.createContext("/old") { exchange ->
+            exchange.responseHeaders.add("X-NovelTracker-Latest-URL", "/book")
+            exchange.sendResponseHeaders(410, -1)
+            exchange.close()
+        }
+        server.createContext("/foreign") { exchange ->
+            exchange.responseHeaders.add("X-NovelTracker-Latest-URL", "http://example.com/book")
+            exchange.sendResponseHeaders(410, -1)
+            exchange.close()
+        }
+    }
+
+    @After fun stop() { server.stop(0) }
+
+    @Test fun readsRangesFromProbedVersion() {
+        val snapshot = RemoteEpubSnapshot.probe(client, "$url/book")
+        assertEquals(4L, snapshot.size)
+        assertArrayEquals(body, snapshot.readRange(0, 4))
+    }
+
+    @Test fun detectsReplacementEvenWithSameLength() {
+        val old = RemoteEpubSnapshot.probe(client, "$url/book")
+        version = "\"v2\""
+        body = byteArrayOf(1, 2, 3, 4)
+        val fresh = RemoteEpubSnapshot.probe(client, "$url/book")
+        assertNotEquals(old.identity, fresh.identity)
+        assertArrayEquals(body, fresh.readRange(0, 4))
+    }
+
+    @Test fun rebuiltZipDiscoversNewChapterOffsets() {
+        fun archive(first: String, second: String) = ZipTestFixtures.buildZip(listOf(
+            ZipTestFixtures.Spec("232.xhtml", first.toByteArray(), stored = true),
+            ZipTestFixtures.Spec("233.xhtml", second.toByteArray(), stored = true),
+        ))
+        body = archive("旧232", "旧233")
+        val old = RemoteEpubSnapshot.probe(client, "$url/book")
+        val oldCore = RemoteZipCore(RangedSource { offset, length, _ -> old.readRange(offset, length) }, "book", old.size)
+        val oldEntry = oldCore.ensureMeta().getValue("233.xhtml")
+        body = archive("232修复内容".repeat(200), "233修复内容")
+        version = "\"v2\""
+        val fresh = RemoteEpubSnapshot.probe(client, "$url/book")
+        val core = RemoteZipCore(RangedSource { offset, length, _ -> fresh.readRange(offset, length) }, "book", fresh.size)
+        val entry = core.ensureMeta().getValue("233.xhtml")
+        assertNotEquals(oldEntry.entryOffset, entry.entryOffset)
+        assertArrayEquals("233修复内容".toByteArray(), core.readDecompressed(entry))
+        try {
+            oldCore.readDecompressed(oldEntry)
+            fail("An old ZIP directory must never read the replacement file")
+        } catch (_: IOException) { }
+    }
+
+    @Test(expected = IOException::class) fun preventsMixedVersionsDuringRead() {
+        val snapshot = RemoteEpubSnapshot.probe(client, "$url/book")
+        version = "\"v2\""
+        snapshot.readRange(0, 4)
+    }
+
+    @Test fun recoversExpiredNovelTrackerAddress() {
+        val snapshot = RemoteEpubSnapshot.probe(client, "$url/old")
+        assertArrayEquals(body, snapshot.readRange(0, 4))
+    }
+
+    @Test(expected = IOException::class) fun rejectsForeignUpdateAddress() {
+        RemoteEpubSnapshot.probe(client, "$url/foreign")
+    }
+
+    @Test(expected = IOException::class) fun rejectsWrongRange() {
+        val snapshot = RemoteEpubSnapshot.probe(client, "$url/book")
+        badRange = true
+        snapshot.readRange(0, 4)
+    }
+}
